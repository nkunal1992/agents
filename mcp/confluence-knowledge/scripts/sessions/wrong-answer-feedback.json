{
  "name": "wrong-answer-feedback",
  "steps": [
    {
      "verb": "spawn_server"
    },
    {
      "verb": "set_clipboard",
      "text": "{token}"
    },
    {
      "verb": "call",
      "tool": "register_token",
      "args": {
        "site": "{base}",
        "env": "datacenter"
      },
      "timeout": 90,
      "expect": {
        "configured": true
      }
    },
    {
      "verb": "call",
      "tool": "connect",
      "args": {
        "root": "{base}/pages/viewpage.action?pageId=100"
      },
      "save": {
        "scope": "scope_handle"
      }
    },
    {
      "verb": "call",
      "tool": "start_crawl",
      "args": {
        "scope_handle": "{scope}"
      },
      "save": {
        "job": "job_id"
      }
    },
    {
      "verb": "wait_crawl",
      "scope": "{scope}",
      "job": "{job}",
      "timeout_s": 180
    },
    {
      "verb": "call",
      "tool": "search",
      "args": {
        "scope_handle": "{scope}",
        "question": "when do deploys happen"
      },
      "save": {
        "es": "evidence_set"
      }
    },
    {
      "verb": "call",
      "tool": "submit_feedback",
      "args": {
        "scope_handle": "{scope}",
        "question": "when do deploys happen",
        "correction": "Thursday 18:00, not 'weekly'",
        "note": "agent answered weekly; actual page says Thursdays"
      },
      "expect_text": [
        "fb",
        "disclosed"
      ]
    },
    {
      "verb": "call",
      "tool": "feedback_report",
      "args": {
        "scope_handle": "{scope}"
      },
      "expect_text": [
        "Thursday 18:00"
      ],
      "note": "the correction must surface in the next report"
    }
  ]
}