{
  "name": "auth-expiry-midcrawl",
  "faults": "stale_token:after=15",
  "steps": [
    {
      "verb": "spawn_server"
    },
    {
      "verb": "set_clipboard",
      "text": "{token}"
    },
    {
      "verb": "call",
      "tool": "register_token",
      "args": {
        "site": "{base}",
        "env": "datacenter"
      },
      "timeout": 90,
      "expect": {
        "configured": true
      }
    },
    {
      "verb": "call",
      "tool": "connect",
      "args": {
        "root": "{base}/pages/viewpage.action?pageId=100"
      },
      "save": {
        "scope": "scope_handle"
      }
    },
    {
      "verb": "call",
      "tool": "start_crawl",
      "args": {
        "scope_handle": "{scope}"
      },
      "save": {
        "job": "job_id"
      }
    },
    {
      "verb": "wait_crawl",
      "scope": "{scope}",
      "job": "{job}",
      "timeout_s": 120,
      "tolerate_errors": true,
      "note": "token revoked mid-crawl \u2192 errors surface, never a wedge",
      "expect_phase": [
        "session expired"
      ],
      "terminal": [
        "done",
        "abandoned",
        "cancelled",
        "error"
      ]
    }
  ],
  "env": {
    "KNOWLEDGE_AUTH_PAUSE_MAX_S": "25",
    "KNOWLEDGE_AUTH_PROBE_S": "3"
  }
}