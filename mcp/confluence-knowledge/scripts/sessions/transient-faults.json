{
  "name": "transient-faults",
  "faults": "429:content/105,500:content/106,drop:content/107,hang:content/108",
  "env": {
    "FAKE_DC_DELAY": "0.05",
    "KNOWLEDGE_FAKE_EMBEDDINGS": "1"
  },
  "steps": [
    {
      "verb": "spawn_server"
    },
    {
      "verb": "set_clipboard",
      "text": "{token}"
    },
    {
      "verb": "call",
      "tool": "register_token",
      "args": {
        "site": "{base}",
        "env": "datacenter"
      },
      "timeout": 90,
      "expect": {
        "configured": true
      }
    },
    {
      "verb": "call",
      "tool": "connect",
      "args": {
        "root": "{base}/pages/viewpage.action?pageId=100"
      },
      "save": {
        "scope": "scope_handle"
      }
    },
    {
      "verb": "call",
      "tool": "start_crawl",
      "args": {
        "scope_handle": "{scope}"
      },
      "save": {
        "job": "job_id"
      }
    },
    {
      "verb": "wait_crawl",
      "scope": "{scope}",
      "job": "{job}",
      "timeout_s": 240,
      "tolerate_errors": true,
      "note": "429/500 retried-then-error; drop/hang must not wedge"
    }
  ]
}