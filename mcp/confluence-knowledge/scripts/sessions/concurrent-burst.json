{
  "name": "concurrent-burst",
  "steps": [
    {
      "verb": "spawn_server"
    },
    {
      "verb": "set_clipboard",
      "text": "{token}"
    },
    {
      "verb": "call",
      "tool": "register_token",
      "args": {
        "site": "{base}",
        "env": "datacenter"
      },
      "timeout": 90,
      "expect": {
        "configured": true
      }
    },
    {
      "verb": "call",
      "tool": "connect",
      "args": {
        "root": "{base}/pages/viewpage.action?pageId=100"
      },
      "save": {
        "scope": "scope_handle"
      }
    },
    {
      "verb": "call",
      "tool": "start_crawl",
      "args": {
        "scope_handle": "{scope}"
      },
      "save": {
        "job": "job_id"
      }
    },
    {
      "verb": "spawn_window2"
    },
    {
      "verb": "burst",
      "tool": "search",
      "n": 6,
      "args": {
        "scope_handle": "{scope}",
        "question": "deploy windows approvals"
      },
      "note": "6 parallel searches mid-crawl \u2014 thread-safety under load"
    },
    {
      "verb": "burst",
      "tool": "crawl_step",
      "n": 4,
      "args": {
        "scope_handle": "{scope}",
        "job_id": "{job}"
      }
    },
    {
      "verb": "wait_crawl",
      "scope": "{scope}",
      "job": "{job}",
      "timeout_s": 180
    },
    {
      "verb": "call",
      "tool": "search",
      "args": {
        "scope_handle": "{scope}",
        "question": "deploy windows"
      },
      "save": {
        "es": "evidence_set"
      },
      "expect_len": {
        "evidence": 1
      }
    },
    {
      "verb": "call",
      "tool": "verify_citations",
      "args": {
        "scope_handle": "{scope}",
        "evidence_set": "{es}",
        "mappings": [
          {
            "claim": "deploys need approvals",
            "chunk_id": "__evidence_first__",
            "quote": ""
          }
        ]
      },
      "tolerate": true,
      "note": "multi-turn: reuse the burst-time evidence set post-crawl"
    }
  ]
}