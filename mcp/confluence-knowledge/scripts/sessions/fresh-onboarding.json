{
  "name": "fresh-onboarding",
  "steps": [
    {"verb": "spawn_server"},
    {"verb": "tools", "must_contain": ["status", "register_token", "connect",
      "start_crawl", "crawl_step", "search", "verify_citations",
      "submit_feedback", "feedback_report"]},
    {"verb": "call", "tool": "status", "expect": {"configured": false}},

    {"verb": "corrupt_clipboard"},
    {"verb": "call", "tool": "register_token",
     "args": {"site": "{base}", "env": "datacenter"}, "timeout": 90,
     "note": "bad clipboard → honest error, nothing persisted"},

    {"verb": "set_clipboard", "text": "{token}"},
    {"verb": "call", "tool": "register_token",
     "args": {"site": "{base}", "env": "datacenter"}, "timeout": 90,
     "expect": {"configured": true}},

    {"verb": "call", "tool": "connect",
     "args": {"root": "{base}/pages/viewpage.action?pageId=100"},
     "save": {"scope": "scope_handle"}},
    {"verb": "call", "tool": "start_crawl",
     "args": {"scope_handle": "{scope}"}, "save": {"job": "job_id"}},
    {"verb": "kill_daemon"},
    {"verb": "wait_crawl", "scope": "{scope}", "job": "{job}",
     "timeout_s": 180},

    {"verb": "call", "tool": "search",
     "args": {"scope_handle": "{scope}", "question": "deploy windows"},
     "expect_len": {"evidence": 1}},
    {"verb": "call", "tool": "verify_citations",
     "args": {"scope_handle": "{scope}", "evidence_set": "{es}",
      "mappings": []}},
    {"verb": "call", "tool": "submit_feedback",
     "args": {"scope_handle": "{scope}", "question": "q",
      "correction": "c", "note": "journey"}},
    {"verb": "call", "tool": "feedback_report",
     "args": {"scope_handle": "{scope}"}},
    {"verb": "call", "tool": "status", "expect": {"configured": true}}
  ]
}
